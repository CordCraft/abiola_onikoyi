// Prisma schema for the private projects area.
// Local development uses SQLite; production uses Postgres (Neon).
// The models below are intentionally provider-agnostic so the same schema
// works in both — we use `prisma db push` rather than migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  summary   String
  // One of: "idea" | "building" | "launched" | "paused" (validated in app code)
  status    String    @default("building")
  link      String?
  startedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updates   Update[]
}

model Update {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String
  body      String // markdown
  createdAt DateTime @default(now())
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  body            String // markdown
  // One of the "What I bring" themes, e.g. "Reservoir & Production"
  category        String
  // "news" | "insight"
  kind            String    @default("insight")
  // SEO
  metaDescription String?
  keywords        String? // comma-separated
  // Article image (sourced from Openverse)
  imageUrl        String?
  imageAlt        String?
  imageCredit     String?
  imageCreditUrl  String?
  sourceUrl       String?
  sourceName      String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// Jarvis — personal second brain (private /jarvis area)
// ---------------------------------------------------------------------------

model JarvisVenture {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      String          @default("active") // active | paused | archived
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projects    JarvisProject[]
  notes       JarvisNote[]
}

model JarvisProject {
  id             String           @id @default(cuid())
  name           String
  venture        JarvisVenture?   @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  ventureId      String?
  status         String           @default("active") // idea | active | stalled | paused | done
  priority       String           @default("medium") // low | medium | high
  summary        String?
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          JarvisTask[]
  notes          JarvisNote[]
  decisions      JarvisDecision[]
  documents      JarvisDocument[]

  @@index([status, lastActivityAt])
}

model JarvisTask {
  id          String         @id @default(cuid())
  project     JarvisProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?
  title       String
  status      String         @default("todo") // todo | doing | done
  priority    String         @default("medium")
  dueDate     DateTime?
  completedAt DateTime?
  // "daily" | "weekly" | "monthly": completing the task spawns the next occurrence
  recurrence  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, dueDate])
}

model JarvisNote {
  id        String         @id @default(cuid())
  project   JarvisProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  venture   JarvisVenture? @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  ventureId String?
  body      String
  tags      String?
  // "capture" = quick-capture inbox item awaiting filing; null = normal note
  source    String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

model JarvisDecision {
  id        String         @id @default(cuid())
  project   JarvisProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  title     String
  rationale String
  createdAt DateTime       @default(now())
}

model JarvisGoal {
  id          String            @id @default(cuid())
  title       String
  description String?
  horizon     String? // freeform, e.g. "wealth", "autism impact"
  status      String            @default("active")
  targetDate  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  milestones  JarvisMilestone[]
}

model JarvisMilestone {
  id        String     @id @default(cuid())
  goal      JarvisGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    String
  title     String
  done      Boolean    @default(false)
  dueDate   DateTime?
  createdAt DateTime   @default(now())
}

model JarvisThread {
  id        String           @id @default(cuid())
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  JarvisMessage[]
  proposals JarvisProposal[]
}

model JarvisMessage {
  id        String       @id @default(cuid())
  thread    JarvisThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  role      String // user | assistant
  content   String
  // SavedRecord[] receipts from the turn that produced this assistant message
  receipts  Json?
  createdAt DateTime     @default(now())

  @@index([threadId, createdAt])
}

// Single-user key-value settings (calendar ICS url, briefing preferences, ...).
model JarvisSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A document uploaded through chat (or elsewhere): the extracted text content
// is stored durably so knowledge from files is never lost, and can be searched
// and re-read by Jarvis in any future conversation.
model JarvisDocument {
  id        String         @id @default(cuid())
  name      String
  mimeType  String?
  content   String // extracted text
  summary   String? // Jarvis-written 1-3 sentence summary
  project   JarvisProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  createdAt DateTime       @default(now())

  @@index([projectId, createdAt])
}

// Checkpoint of an in-flight chat turn. Long research turns outlive a single
// Netlify invocation; the route checkpoints here and the client immediately
// resumes in a fresh invocation. Rows are consumed on resume.
model JarvisTurnState {
  id        String   @id @default(cuid())
  threadId  String
  state     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Web Push subscription for one browser/device (proactive briefings + nudges).
model JarvisPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model JarvisProposal {
  id        String        @id @default(cuid())
  thread    JarvisThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String?
  kind      String // create_project | update_project | create_task | log_note | log_decision | set_goal
  summary   String // human-readable one-liner for the confirm card
  payload   Json
  status    String        @default("pending") // pending | applied | discarded
  createdAt DateTime      @default(now())
  appliedAt DateTime?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Trading dashboard (private /dashboard/trading)
// One MT5 account per row, fed by the Reporter EA posting to
// /api/trading/ingest. Tables are created in production by
// ensureTradingTables() in src/lib/trading/setup.ts (idempotent raw DDL),
// since deploys never run `prisma db push`. Keep that DDL in sync.
// ---------------------------------------------------------------------------

model TradingAccount {
  id        String @id @default(cuid())
  // `${login}@${server}` so the same login on a demo and live server stay apart
  accountKey String @unique
  login     String
  server    String
  broker    String // company name reported by the terminal
  label     String? // friendly name set in the EA inputs, e.g. "Vantage"
  name      String? // account holder name reported by the terminal
  currency  String  @default("USD")
  leverage  Int?
  // Live state, overwritten on every EA post
  balance       Float    @default(0)
  equity        Float    @default(0)
  margin        Float    @default(0)
  freeMargin    Float    @default(0)
  // Percent; null when no positions are open (margin = 0)
  marginLevel   Float?
  floatingPnl   Float    @default(0)
  positionCount Int      @default(0)
  // Open positions as reported in the latest snapshot (array of objects)
  openPositions Json?
  // Broker server clock minus GMT, in seconds (deal times arrive in server time)
  gmtOffsetSeconds Int @default(0)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deals     TradingDeal[]
  snapshots TradingSnapshot[]
}

// Raw MT5 deals (one row per fill). A "trade" in the UI is the set of deals
// sharing a positionId; grouping happens in src/lib/trading/data.ts.
model TradingDeal {
  id         String         @id @default(cuid())
  account    TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  // MT5 tickets exceed 2^31; stored as strings to keep JSON serialisation safe
  ticket     String
  orderTicket String?
  positionId String?
  symbol     String
  // "buy" | "sell" | "balance" | "credit" | "other"
  type       String
  // "in" | "out" | "inout" | "out_by" | "" (balance ops)
  entry      String @default("")
  volume     Float  @default(0)
  price      Float  @default(0)
  sl         Float?
  tp         Float?
  profit     Float  @default(0)
  swap       Float  @default(0)
  commission Float  @default(0)
  fee        Float  @default(0)
  magic      String?
  comment    String?
  // UTC (EA reports the broker GMT offset and the server converts)
  time DateTime

  @@unique([accountId, ticket])
  @@index([accountId, time])
  @@index([accountId, positionId])
}

// Periodic equity/margin snapshots. Stored on every EA post while positions
// are open (30s granularity for drawdown and stop-out analysis), and roughly
// every 15 minutes while flat.
model TradingSnapshot {
  id        String         @id @default(cuid())
  account   TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  at        DateTime       @default(now())
  balance     Float
  equity      Float
  margin      Float @default(0)
  freeMargin  Float @default(0)
  marginLevel Float?
  floatingPnl Float @default(0)
  positionCount Int @default(0)
  // Open positions at snapshot time (only stored while positions are open)
  positions Json?

  @@index([accountId, at])
}

// ---------------------------------------------------------------------------
// Mentorship programme (public /mentorship + mentee portal + admin area)
// Tables are created in production by ensureMentorshipTables() in
// src/lib/mentorship/setup.ts (idempotent raw DDL), since deploys never run
// `prisma db push` automatically. Keep that DDL in sync with these models.
// ---------------------------------------------------------------------------

model MentorshipMentee {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique // stored lowercase
  accessCode  String    @unique // invite code the mentor shares privately
  headline    String? // e.g. "500-level Chemical Engineering, UNILAG"
  focusArea   String? // e.g. "Process safety and tech"
  cohort      String    @default("2026-C1")
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Account + onboarding profile (collected by the first-login wizard).
  // passwordHash is bcrypt; photoData is a browser-compressed jpeg data URL.
  passwordHash    String?
  onboardedAt     DateTime?
  photoData       String?
  phone           String? // WhatsApp preferred
  linkedin        String?
  level           String? // e.g. "500 Level"
  gradYear        String? // expected graduation year
  interests       String? // comma-separated focus areas
  backgroundStory String? // their story in their own words
  skills          String? // technical skills, software, tools
  dreamRoles      String? // target roles or companies
  aspirations     String? // 2-year vision
  longTermVision  String? // 5-year vision
  expectations    String? // what they want from the mentorship
  challenges      String? // biggest current challenge
  availability    String? // preferred meeting windows
  commsPref       String? // whatsapp | email | portal | call

  // Auto-generated programme design (new signups): short track name shown in
  // the UI, and the JSON blueprint (capstone + 13 week themes) that steers
  // week-by-week task generation in src/lib/mentorship/program-gen.ts.
  track            String?
  programBlueprint String?

  goals    MentorshipGoal[]
  tasks    MentorshipTask[]
  checkins MentorshipCheckin[]
  messages MentorshipMessage[]
  sessions MentorshipSession[]
  planDays MentorshipPlanDay[]  @relation("planDays")
  aiTools  MentorshipAiTool[]   @relation("aiTools")
}

model MentorshipGoal {
  id          String           @id @default(cuid())
  mentee      MentorshipMentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId    String
  title       String
  detail      String?
  // "active" | "completed" | "dropped" (validated in app code)
  status      String           @default("active")
  // Programme month the goal targets: 1, 2 or 3
  targetMonth Int?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tasks       MentorshipTask[]

  @@index([menteeId, status])
}

model MentorshipTask {
  id          String           @id @default(cuid())
  mentee      MentorshipMentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId    String
  goal        MentorshipGoal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalId      String?
  title       String
  notes       String?
  // "mentor" | "mentee": who created the task
  createdBy   String           @default("mentor")
  dueDate     DateTime?
  // "todo" | "done"
  status      String           @default("todo")
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([menteeId, status])
}

model MentorshipCheckin {
  id          String           @id @default(cuid())
  mentee      MentorshipMentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId    String
  // Programme week number (1..13)
  week        Int
  wins        String
  blockers    String?
  nextFocus   String?
  // Self-rated confidence for the week, 1..5
  confidence  Int?
  mentorReply String?
  repliedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([menteeId, week])
  @@index([createdAt])
}

model MentorshipMessage {
  id        String           @id @default(cuid())
  mentee    MentorshipMentee @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId  String
  // "mentor" | "mentee"
  sender    String
  body      String
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([menteeId, createdAt])
}

model MentorshipSession {
  id          String            @id @default(cuid())
  title       String
  // "group" | "one_on_one"
  kind        String            @default("group")
  // Null for group sessions (whole cohort)
  mentee      MentorshipMentee? @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId    String?
  scheduledAt DateTime
  link        String? // Google Meet or similar
  agenda      String?
  notes       String? // mentor's post-session notes, visible to attendees
  // "upcoming" | "completed" | "cancelled"
  status      String            @default("upcoming")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([scheduledAt])
}

// One dated day of the personalized daily programme. Days are auto-assigned
// by calendar date (Africa/Lagos); the mentee completes the day by submitting
// a short reflection and confidence rating, which is their daily check-in.
model MentorshipPlanDay {
  id       String           @id @default(cuid())
  mentee   MentorshipMentee @relation("planDays", fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId String
  // 1..91 across the three months
  dayIndex Int
  // The Lagos calendar date this day belongs to, stored at UTC midnight
  date     DateTime
  // Programme week 1..13
  week     Int
  title    String
  // Morning mindset brief: a short self-esteem / mindset exercise
  mindset  String?

  // Daily check-in, filled when the mentee closes out the day
  completedAt DateTime?
  reflection  String?
  confidence  Int?

  // Mentor feedback on the day's work
  mentorComment String?
  repliedAt     DateTime?

  createdAt DateTime             @default(now())
  tasks     MentorshipPlanTask[]

  @@unique([menteeId, dayIndex])
  @@index([menteeId, date])
}

model MentorshipPlanTask {
  id       String            @id @default(cuid())
  day      MentorshipPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId    String
  menteeId String
  order    Int               @default(0)
  // "mindset" | "skill" | "project" | "career" | "checkpoint"
  kind     String            @default("skill")
  title    String
  detail   String?
  // Rough effort estimate shown to the mentee
  minutes  Int               @default(30)
  // Points feed the running score and streak display
  points   Int               @default(10)
  // When set, the portal shows an evidence box with this hint and the task
  // needs evidence text (a link, an answer, a summary) to be marked done
  evidenceHint String?

  // "todo" | "done"
  status        String    @default("todo")
  completedAt   DateTime?
  evidence      String?
  mentorComment String?

  @@index([menteeId, status])
  @@index([dayId, order])
}

// AI tool access the mentor provisions per mentee (OpenAI, Claude, fal.ai).
// The key is pasted by the mentor in the admin area and shown to the mentee
// in their AI Toolkit once granted.
model MentorshipAiTool {
  id       String           @id @default(cuid())
  mentee   MentorshipMentee @relation("aiTools", fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId String
  // "openai" | "anthropic" | "fal"
  tool     String
  // "available" | "requested" | "granted"
  status   String           @default("available")
  apiKey   String?
  // Mentee's note on what they want it for / mentor's guidance
  note      String?
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())

  @@unique([menteeId, tool])
}

model MentorshipResource {
  id        String   @id @default(cuid())
  title     String
  url       String?
  note      String?
  // "reading" | "video" | "course" | "tool" | "other"
  category  String   @default("reading")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MentorshipAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}
